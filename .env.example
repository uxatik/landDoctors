# Copy to .env.local and fill in. Never commit .env.local.

# Public (shown in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HOTLINE=+8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP=+8801XXXXXXXXX
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Server only (secret)
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
PAYMENTS_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Optional: browser tests against your Supabase project (npm run e2e with E2E_DB=1)
E2E_OPS_EMAIL=
E2E_OPS_PASSWORD=
E2E_OPS_TOTP_SECRET=
E2E_OFFER_TOKEN=
