# Copy to .env.local and fill in. Never commit .env.local.

# Public values (they appear on the site). The NEXT_PUBLIC_ prefix is optional:
# SITE_URL and NEXT_PUBLIC_SITE_URL both work, and so on for each line.
SITE_URL=http://localhost:3000
HOTLINE=+8801XXXXXXXXX
WHATSAPP=+8801XXXXXXXXX
# Show call buttons and the hotline number on the site. Leave off until someone answers the phone.
CALLS_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
GA_ID=
CLARITY_ID=

# Server only (secret)
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
PAYMENTS_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Optional: browser tests against your Supabase project (npm run e2e with E2E_DB=1)
E2E_OPS_EMAIL=
E2E_OPS_PASSWORD=
E2E_OPS_TOTP_SECRET=
E2E_OFFER_TOKEN=
